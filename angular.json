{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nearby-market": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "nm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "styles": ["src/styles.css"],
            "assets": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "650kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "22kB", "maximumError": "28kB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "nearby-market:build:production" },
            "development": { "buildTarget": "nearby-market:build:development" }
          },
          "defaultConfiguration": "development",
          "options": { "proxyConfig": "proxy.conf.json" }
        }
      }
    }
  },
  "cli": {
    "analytics": "b942a001-68c2-42f0-b7fc-121519066cac"
  }
}